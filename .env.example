# ============================================================================
# SITUR — Variables de entorno (plantilla)
#
# NO uses este archivo directamente. El flujo real es:
#
#   1. node scripts/generar-secretos.mjs   → crea `secretos.env` con VAPID,
#      CRON_SECRET y la contraseña del administrador
#   2. rellena en `secretos.env` los datos de Supabase y Upstash
#   3. node scripts/enlace-local.mjs        → escribe `.env.local` con SOLO
#      las variables públicas
#
# Esta plantilla está para saber qué se necesita. Los archivos `.env*` no se
# suben al repositorio.
# ============================================================================

# --- Supabase (panel del proyecto > Settings > API) -------------------------
# Las van al NAVEGADOR. La clave anon respeta la RLS: con ella, el rol
# `anon`/`authenticated` solo ve lo que las políticas permiten.
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# --- Web Push (VAPID) ------------------------------------------------------
# Clave pública del par VAPID. Solo al navegador.
# Se genera una vez con:  node scripts/generar-secretos.mjs
VITE_VAPID_PUBLIC_KEY=BNgWagLgUDGDIMCwppzTi81Q...

# ============================================================================
# SOLO EL SERVIDOR (Vercel). Ninguna de estas llega al navegador.
# Las pone `scripts/desplegar.sh`; en local las lee el plugin de desarrollo.
# ============================================================================

# URL del proyecto, para las funciones de `api/`.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# La clave anon también se usa en el servidor, para `api/suscripcion`: es la
# que puede llamar a `registrar_suscripcion_push` sin sesión (lo que autoriza
# es conocer el token, no haber iniciado sesión).
SUPABASE_ANON_KEY=eyJhbGciOi...

# La service_role SE SALTA la RLS. Solo la usa `/api/push` para leer la cola
# de avisos. Si esta clave llega al navegador, todo el modelo de seguridad se
# cae. `scripts/enlace-local.mjs` se encarga de que no llegue.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# Par VAPID completo. La privada firma los avisos.
VAPID_PUBLIC_KEY=BNgWagLgUDGDIMCwppzTi81Q...
VAPID_PRIVATE_KEY=PDdjtgwzx2...
VAPID_SUBJECT=mailto:catastro@durango.gob.mx

# Autoriza al cron de Vercel a llamar a POST /api/push.
# Sin este valor, /api/push se rechaza en producción: es lo correcto, porque
# mejor no enviar avisos que dejarlos abiertos a internet (DRS §10).
CRON_SECRET=unaCadenaAleatoriaLarga

# Upstash Redis: los contadores del límite de tasa del Edge Middleware.
# Si no se configura, el middleware deja pasar: es preferible un despliegue
# sin límite a un despliegue que no arranca.
UPSTASH_REDIS_REST_URL=https://xxxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=xxxx
